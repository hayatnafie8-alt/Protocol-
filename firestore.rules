rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Clinical Skills Collection
    match /skills/{skillId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 2. Feed Posts Collection
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 3. Supervisor Notes Collection
    match /supervisor_notes/{noteId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 4. Notifications Stream Collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 5. Subscription Requests & Mastercard Receipts Collection
    match /subscription_requests/{requestId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 6. Friends Discount Codes Collection
    match /friends_discount_codes/{codeId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 7. App Configuration Collection
    match /app_config/{configId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 8. Surgical Cases Collection
    match /surgical_cases/{caseId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 9. Active User Sessions Collection (Single-Device Session Enforcement)
    match /active_sessions/{emailKey} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 10. Emergency & Prescription Drugs Collection (Full CRUD & Visibility Controls)
    match /prescription_drugs/{drugId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 11. Prescription Guide Global Visibility Configuration
    match /prescription_guide_config/{configId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 12. Clinical Report Export Requests Collection
    match /report_export_requests/{requestId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 13. Clinical Cases & Photo Archive Collection
    match /clinical_cases/{caseId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 14. College Clinic Schedules Collection
    match /clinic_schedules/{scheduleId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 15. Student Skills Activity Logs Collection (Aggregated Growth & Analytics)
    match /student_activity_logs/{logId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 16. Clinic Viva Examination Questions Collection
    match /clinic_viva_questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
